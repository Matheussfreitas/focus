# Ambiente de desenvolvimento local: copie para .env.dev
# Banco local do docker-compose.yml (npm run dev:db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/focus_dev"

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-secret-nao-usar-em-producao
SERVER_URL="http://localhost:3000"

# Entra automaticamente como o usuário dev (criado pelo seed), sem login.
# Só tem efeito no `vite dev`; o build de produção ignora.
VITE_DEV_AUTH_BYPASS=true
