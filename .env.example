
# Database URL for PostgreSQL
DATABASE_URL="postgresql://postgres:docker@localhost:5432/mydb"
# Direct (non-pooled) connection used by Prisma CLI for migrations. Optional: falls back to DATABASE_URL
DATABASE_URL_UNPOOLED=

# Better Auth configuration
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate a secret key: `npx -y @better-auth/cli secret`

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
